#!/bin/sh

limit=$(ulimit -d 2>/dev/null)
if [ -n "$limit" ] && [ "$limit" != "unlimited" ]; then
  limit_gb=$(( limit / 1024 / 1024 ))
  if [ "$limit" -lt 7340032 ]; then
    echo "ERROR: ulimit -d is ${limit_gb}G (${limit} KB). Need at least 7G (7340032 KB)."
    echo "  Try: ulimit -d unlimited"
    echo "  Or in the chroot config, set: data-limit = 7340032"
    exit 1
  fi
fi

rm -rf .next
pnpm install

# Motores (https://gitlab.com/pasosdeJesus/m/-/work_items/35 Fase 4): se consumen vía dist/ (exports map) y dist/ NO está
# en git (artefacto de build). Compilar antes de servir — un checkout fresco
# fallaría con "Module not found: ... dist/lib/...".
#
# Se llama al target del Makefile en vez de repetir el bucle aquí: el orden
# (rewards antes que gdcluster) y la lista de paquetes viven en un solo lugar. Una
# edición en packages/* se ve al REINICIAR bin/dev: un `next dev` en marcha sigue
# sirviendo el dist anterior (2026-09-19, costó un diagnóstico).
make engines-dist || echo "[bin/dev] AVISO: falló la compilación de motores (¿pnpm install pendiente en packages/*?)"

# Artefactos del PWA (public/sw.js, workbox-*, fallback-*, worker-*): limpiar los
# que haya dejado una compilación anterior. Con el PWA encendido next-pwa los
# regenera al compilar; con el PWA apagado (disable: true) no, y un sw.js viejo
# se seguiría sirviendo (ver doc/pwa-developer-guide.md).
make pwa-clean || true

. ../.env
cmd="node_modules/next/dist/bin/next dev -p${PORT} --webpack ${OPDEV}"
echo $cmd
eval $cmd
