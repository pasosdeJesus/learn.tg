{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/*": [
        "./node_modules/next/*"
      ],
      "next": [
        "./node_modules/next"
      ],
      "kysely": [
        "./node_modules/kysely"
      ],
      // Motores link: (https://gitlab.com/pasosdeJesus/m/-/work_items/35 Fase 3) — puente de resolución para imports
      // cross-motor (gdcluster → rewards) y desde el core.
      "@learn-tg/mr519/*": [
        "./node_modules/@learn-tg/mr519/*"
      ],
      "viem": [
        "./node_modules/viem"
      ],
      "viem/accounts": [
        "./node_modules/viem/_types/accounts/index.d.ts"
      ],
      "viem/chains": [
        "./node_modules/viem/_types/chains/index.d.ts"
      ],
      "@pasosdejesus/m/*": [
        "./node_modules/@pasosdejesus/m/dist/*"
      ],
      "@pasosdejesus/mpdj/*": [
        "./node_modules/@pasosdejesus/mpdj/dist/*"
      ],
      "@pasosdejesus/usdt/*": [
        "./node_modules/@pasosdejesus/usdt/dist/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**"
  ]
}
