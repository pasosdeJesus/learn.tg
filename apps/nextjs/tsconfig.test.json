{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "next/*": ["./node_modules/next/*"],
      "next": ["./node_modules/next"],
      "kysely": ["./node_modules/kysely"],
      "viem": ["./node_modules/viem"],
      "viem/accounts": ["./node_modules/viem/_types/accounts/index.d.ts"],
      "viem/chains": ["./node_modules/viem/_types/chains/index.d.ts"],
      "@learn-tg/rewards/*": ["./node_modules/@learn-tg/rewards/*"],
      "@learn-tg/gdcluster/*": ["./node_modules/@learn-tg/gdcluster/*"],
      "@learn-tg/mr519/*": ["./node_modules/@learn-tg/mr519/*"],
      "@pasosdejesus/m/*": ["./node_modules/@pasosdejesus/m/dist/*"],
      "@pasosdejesus/mpdj/*": ["./node_modules/@pasosdejesus/mpdj/dist/*"]
    },
    "types": ["@testing-library/jest-dom", "vitest", "vitest/globals"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "types/**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
