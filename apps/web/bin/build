#!/bin/sh
#
# `next build` con el límite de descriptores necesario en OpenBSD/adJ.
#
# Next abre muchos archivos durante "Collecting build traces"; con el límite
# blando por defecto (512) el build muere con:
#   Error: EMFILE: too many open files, open '.../.next/export-marker.json'
#
# Este envoltorio intenta subir el límite blando hasta el duro del login class.
# Si el duro es menor de 4096, el operador debe subirlo en /etc/login.conf
# (`openfiles-cur`/`openfiles-max`), ejecutar `doas cap_mkdb /etc/login.conf` y
# volver a entrar.
#
set -e

current=$(ulimit -n 2>/dev/null || echo 0)
if [ "$current" != "unlimited" ] && [ "$current" -lt 4096 ] 2>/dev/null; then
  for n in 8192 4096 2048 1024; do
    if ulimit -n "$n" 2>/dev/null; then
      break
    fi
  done
fi
echo "[build] file descriptors: $(ulimit -n 2>/dev/null || echo desconocido)"

exec node_modules/next/dist/bin/next build --webpack "$@"
