diff --git a/dist/esm/shared/lib/errors/code-frame.js b/dist/esm/shared/lib/errors/code-frame.js
--- a/dist/esm/shared/lib/errors/code-frame.js
+++ b/dist/esm/shared/lib/errors/code-frame.js
@@ -7,6 +7,22 @@
     if (options.maxWidth === undefined) {
         options.maxWidth = process.stdout.columns;
     }
+    // El binding WASM (openbsd/adJ) deserializa `color` como el enum
+    // `None|Error|Warning|Info` y `maxWidth` como numero: Next le pasa `false`/
+    // `true` y `maxWidth: undefined`, y el binding lanza
+    // ("invalid type: boolean `false`, expected enum CodeFrameColorMode" /
+    // "invalid type: unit value, expected usize").
+    // `color: false` se borra (el default de ambas rutas es "sin color"); el
+    // enum del binding nativo NO tiene `None`, asi que mandar 'None' romperia ahí.
+    if (options.color === false) {
+        delete options.color;
+    } else if (options.color === true) {
+        options.color = 'Error';
+    }
+    // `process.stdout.columns` no existe cuando la salida no es una terminal.
+    if (typeof options.maxWidth !== 'number') {
+        options.maxWidth = 100;
+    }
     return getBindingsSync().codeFrameColumns(file, location, options);
 }
 
