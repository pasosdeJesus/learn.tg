{
  "name": "generated-msip",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Copia vendorizada de @pasosdejesus/msip v1.2.1, generada por `bin/m eng:sync --vendor`; no editar a mano.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./model": {
      "import": "./dist/model.js",
      "types": "./dist/model.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.generated.js",
      "types": "./dist/schema.generated.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsc -b",
    "typecheck": "npx tsc -b --pretty false",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "kysely": ">=0.28.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "kysely": ">=0.28.0",
    "typescript": "5.9.3"
  }
}
