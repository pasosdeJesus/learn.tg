{
  "name": "generated-msip",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Copia vendorizada de @pasosdejesus/msip v1.1.0, generada por `bin/m eng:sync --vendor`; no editar a mano.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./model": {
      "import": "./dist/model.js",
      "types": "./dist/model.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsc -b",
    "typecheck": "npx tsc -b --pretty false",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  }
}
